#!/usr/bin/env bash
set -euo pipefail

install_brunost() {
  local install_type="$1"
  local version="$2"
  local install_path="$3"

  if [ "$install_type" != "version" ]; then
    echo "asdf-brunost: only version installs are supported" >&2
    exit 1
  fi

  local os arch binary_name
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"

  case "$os" in
    linux)
      case "$arch" in
        x86_64)          binary_name="brunost-linux-x86_64" ;;
        aarch64|arm64)   binary_name="brunost-linux-aarch64" ;;
        *) echo "asdf-brunost: unsupported architecture: $arch" >&2; exit 1 ;;
      esac
      ;;
    darwin)
      case "$arch" in
        x86_64)   binary_name="brunost-macos-x86_64" ;;
        arm64)    binary_name="brunost-macos-aarch64" ;;
        *) echo "asdf-brunost: unsupported architecture: $arch" >&2; exit 1 ;;
      esac
      ;;
    *)
      echo "asdf-brunost: unsupported operating system: $os" >&2
      exit 1
      ;;
  esac

  local url="https://github.com/atomfinger/brunost/releases/download/v${version}/${binary_name}"

  mkdir -p "${install_path}/bin"
  curl -fsSL "$url" -o "${install_path}/bin/brunost"
  chmod +x "${install_path}/bin/brunost"
}

install_brunost "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH"
